{
  "name": "react-drag-dva",
  "version": "0.2.0",
  "type": "module",
  "description": "可视化拖拽编辑器组件库:拖入组件、移动/缩放/分组,支持受控模式与自定义元素类型。",
  "license": "MIT",
  "keywords": [
    "react",
    "drag-and-drop",
    "visual-editor",
    "canvas",
    "antd",
    "jotai",
    "react-moveable",
    "component-library"
  ],
  "author": "shijunwen",
  "homepage": "https://github.com/shijunwen/react-drag-dva#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shijunwen/react-drag-dva.git"
  },
  "bugs": {
    "url": "https://github.com/shijunwen/react-drag-dva/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.less"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.js && node -e \"require('fs').copyFileSync('src/index.d.ts','dist/index.d.ts')\"",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "lint": "eslint src examples --ext .js,.jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src examples --ext .js,.jsx --fix",
    "prepublishOnly": "pnpm lint && pnpm build:lib"
  },
  "peerDependencies": {
    "@ant-design/icons": ">=6",
    "@dnd-kit/core": ">=6",
    "@dnd-kit/utilities": ">=3",
    "@scena/react-guides": ">=0.28",
    "ahooks": ">=3",
    "antd": ">=6",
    "jotai": ">=2",
    "react": ">=18",
    "react-dom": ">=18",
    "react-infinite-viewer": ">=0.28",
    "react-moveable": ">=0.56",
    "react-selecto": ">=1.26"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@scena/react-guides": "^0.28.2",
    "@vitejs/plugin-react": "^4.3.1",
    "ahooks": "^3.9.7",
    "antd": "^6.3.5",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "happy-dom": "^20.11.1",
    "jotai": "^2.19.0",
    "less": "^4.6.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-infinite-viewer": "^0.28.1",
    "react-moveable": "^0.56.0",
    "react-selecto": "^1.26.3",
    "vite": "^5.4.2",
    "vitest": "^4.1.10"
  }
}
